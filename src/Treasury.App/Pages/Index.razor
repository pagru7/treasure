@page "/"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject TreasuryDbContext DbContext

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 pa-sm-6">
    <MudStack Row="false" Spacing="3">
        <MudText Typo="Typo.h4">Household dashboard</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">A quick view of balances and actions for your family budget.</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">PLN total</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@FormatCurrency(_summary.TotalPln, "PLN")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">EUR total</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@FormatCurrency(_totalsByCurrency.GetValueOrDefault("EUR", 0m), "EUR")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Cash flow</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@FormatSigned(_recentCashFlow, "PLN")</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Bills due</MudText>
                    <MudText Typo="Typo.h5" Class="mt-2">@_billsDueCount upcoming</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Recent transactions</MudText>
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Tertiary" Href="/transactions">Add transaction</MudButton>
                    </MudStack>
                    <MudList T="string" Class="mt-3">
                        @foreach (var item in _recentTransactions)
                        {
                            <MudListItem>@item.Description · @FormatSigned(item.Amount, item.Currency)</MudListItem>
                        }
                    </MudList>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                    <MudText Typo="Typo.h6">Quick actions</MudText>
                    <MudStack Class="mt-3" Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Href="/accounts">Create account</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/budgets">Set budgets</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Tertiary" Href="/rates">View rates</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4 rounded-xl" Elevation="2">
            <MudText Typo="Typo.h6">Budget health</MudText>
            @if (_budgetStatus.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">No budgets created yet. Add your first monthly category cap to start tracking family spending.</MudText>
            }
            else
            {
                <MudStack Class="mt-3" Spacing="2">
                    @foreach (var item in _budgetStatus)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText>@item.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatCurrency(item.Spent, item.Currency) / @FormatCurrency(item.Limit, item.Currency)</MudText>
                        </MudStack>
                        <MudProgressLinear Value="@(Math.Clamp((double)(item.Spent / Math.Max(item.Limit, 0.01m) * 100m), 0, 100))" Color="@(item.IsOverBudget ? Color.Error : Color.Success)" Rounded="true" Size="Size.Medium" />
                    }
                </MudStack>
            }
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private Treasury.App.Application.Dashboard.DashboardSummaryResponse _summary = new();
    private readonly Dictionary<string, decimal> _totalsByCurrency = new();
    private readonly List<Treasury.App.Domain.Transaction> _recentTransactions = new();
    private readonly List<BudgetStatusItem> _budgetStatus = new();
    private decimal _recentCashFlow;
    private int _billsDueCount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/auth/login", forceLoad: true);
            return;
        }

        var householdId = await DbContext.Households
            .OrderBy(x => x.Id)
            .Select(x => x.Id)
            .FirstOrDefaultAsync();

        var accounts = await DbContext.Accounts
            .Where(x => x.HouseholdId == householdId)
            .ToListAsync();

        _totalsByCurrency.Clear();
        foreach (var account in accounts)
        {
            _totalsByCurrency[account.Currency] = _totalsByCurrency.GetValueOrDefault(account.Currency, 0m) + account.CurrentBalance;
        }

        var rates = new Dictionary<string, decimal>
        {
            ["EUR"] = 4.6m,
            ["USD"] = 3.9m,
            ["GBP"] = 5.3m
        };

        _summary = new DashboardSummaryService().BuildSummary(
            accounts.Select(x => new AccountValueItem(x.Currency, x.CurrentBalance)),
            rates);

        _recentTransactions.Clear();
        _recentTransactions.AddRange(await DbContext.Transactions
            .Where(x => x.HouseholdId == householdId)
            .OrderByDescending(x => x.TransactionDate)
            .Take(5)
            .ToListAsync());

        _recentCashFlow = _recentTransactions
            .Where(x => x.Currency == "PLN")
            .Sum(x => x.Type == "expense" ? -x.Amount : x.Type == "income" ? x.Amount : 0m);

        _billsDueCount = await DbContext.Bills
            .Where(x => x.HouseholdId == householdId && !x.IsPaid)
            .CountAsync();

        var monthStart = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
        var thisMonthExpenses = await DbContext.Transactions
            .Where(x => x.HouseholdId == householdId && x.TransactionDate >= monthStart && x.Type == "expense")
            .ToListAsync();

        var budgets = await DbContext.BudgetCategories
            .Where(x => x.HouseholdId == householdId)
            .OrderBy(x => x.Name)
            .ToListAsync();

        _budgetStatus.Clear();
        foreach (var budget in budgets)
        {
            var spent = thisMonthExpenses
                .Where(x => x.Category.Equals(budget.Name, StringComparison.OrdinalIgnoreCase))
                .Sum(x => x.Amount);

            _budgetStatus.Add(new BudgetStatusItem(
                budget.Name,
                budget.MonthlyLimit,
                budget.Currency,
                spent,
                spent > budget.MonthlyLimit));
        }
    }

    private static string FormatCurrency(decimal value, string currency) => $"{value:N2} {currency}";

    private static string FormatSigned(decimal value, string currency)
    {
        var prefix = value >= 0 ? "+" : "-";
        return $"{prefix}{Math.Abs(value):N2} {currency}";
    }

    private sealed record BudgetStatusItem(string Name, decimal Limit, string Currency, decimal Spent, bool IsOverBudget);
}
