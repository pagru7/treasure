@page "/bills"
@attribute [Authorize]
@inject TreasuryDbContext DbContext
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 pa-sm-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h4">Bills</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Add" OnClick="ToggleCreateForm">Add bill</MudButton>
        </MudStack>

        @if (_showCreateForm)
        {
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" md="3">
                        <MudTextField Label="Bill name" @bind-Value="_newBill.Name" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="string" Label="Category" @bind-Value="_newBill.Category">
                            <MudSelectItem Value="@("Housing")">Housing</MudSelectItem>
                            <MudSelectItem Value="@("Utilities")">Utilities</MudSelectItem>
                            <MudSelectItem Value="@("Insurance")">Insurance</MudSelectItem>
                            <MudSelectItem Value="@("Health")">Health</MudSelectItem>
                            <MudSelectItem Value="@("Subscriptions")">Subscriptions</MudSelectItem>
                            <MudSelectItem Value="@("General")">General</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField Label="Amount" @bind-Value="_newBill.Amount" Min="0.01m" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="string" Label="Currency" @bind-Value="_newBill.Currency">
                            <MudSelectItem Value="@("PLN")">PLN</MudSelectItem>
                            <MudSelectItem Value="@("EUR")">EUR</MudSelectItem>
                            <MudSelectItem Value="@("USD")">USD</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="1">
                        <MudNumericField Label="Due day" @bind-Value="_newBill.DueDay" Min="1" Max="31" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudCheckBox @bind-Value="_newBill.IsPaid" Label="Paid" />
                    </MudItem>
                </MudGrid>

                <MudTextField Label="Notes" @bind-Value="_newBill.Notes" Class="mt-3" />

                <MudStack Row="true" Class="mt-4" Justify="Justify.FlexEnd">
                    <MudButton Variant="Variant.Text" OnClick="ToggleCreateForm">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="CreateBillAsync">Save bill</MudButton>
                </MudStack>
            </MudPaper>
        }

        @if (_bills.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No recurring bills yet. Add the first family payment to keep the budget under control.</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-4 rounded-xl" Elevation="2">
                <MudTable T="Treasury.App.Domain.Bill" Items="_bills" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Bill</MudTh>
                        <MudTh>Category</MudTh>
                        <MudTh>Due day</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Paid</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Bill">@context.Name</MudTd>
                        <MudTd DataLabel="Category">@context.Category</MudTd>
                        <MudTd DataLabel="Due day">@context.DueDay</MudTd>
                        <MudTd DataLabel="Amount">@context.Amount.ToString("N2") @context.Currency</MudTd>
                        <MudTd DataLabel="Paid">
                            @if (context.IsPaid)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Paid</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small">Due</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private List<Treasury.App.Domain.Bill> _bills = new();
    private bool _showCreateForm;
    private readonly NewBillForm _newBill = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBillsAsync();
    }

    private async Task LoadBillsAsync()
    {
        var householdId = await DbContext.Households
            .OrderBy(x => x.Id)
            .Select(x => x.Id)
            .FirstOrDefaultAsync();

        _bills = await DbContext.Bills
            .Where(x => x.HouseholdId == householdId)
            .OrderBy(x => x.DueDay)
            .ThenBy(x => x.Name)
            .ToListAsync();
    }

    private void ToggleCreateForm()
    {
        _showCreateForm = !_showCreateForm;
        if (!_showCreateForm)
        {
            ResetForm();
        }
    }

    private async Task CreateBillAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBill.Name) || _newBill.Amount <= 0m)
        {
            Snackbar.Add("Bill name and positive amount are required.", Severity.Warning);
            return;
        }

        var householdId = await DbContext.Households
            .OrderBy(x => x.Id)
            .Select(x => x.Id)
            .FirstOrDefaultAsync();

        var bill = new Treasury.App.Domain.Bill
        {
            HouseholdId = householdId == Guid.Empty ? Guid.Parse("11111111-1111-1111-1111-111111111111") : householdId,
            Name = _newBill.Name.Trim(),
            Category = string.IsNullOrWhiteSpace(_newBill.Category) ? "General" : _newBill.Category.Trim(),
            Amount = _newBill.Amount,
            Currency = string.IsNullOrWhiteSpace(_newBill.Currency) ? "PLN" : _newBill.Currency.Trim().ToUpperInvariant(),
            DueDay = _newBill.DueDay <= 0 ? 1 : Math.Min(_newBill.DueDay, 31),
            IsPaid = _newBill.IsPaid,
            Notes = _newBill.Notes?.Trim() ?? string.Empty,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };

        DbContext.Bills.Add(bill);
        await DbContext.SaveChangesAsync();

        ResetForm();
        _showCreateForm = false;
        Snackbar.Add("Bill added.", Severity.Success);
        await LoadBillsAsync();
    }

    private void ResetForm()
    {
        _newBill.Name = string.Empty;
        _newBill.Category = "Housing";
        _newBill.Amount = 0m;
        _newBill.Currency = "PLN";
        _newBill.DueDay = 1;
        _newBill.IsPaid = false;
        _newBill.Notes = string.Empty;
    }

    private sealed class NewBillForm
    {
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = "Housing";
        public decimal Amount { get; set; }
        public string Currency { get; set; } = "PLN";
        public int DueDay { get; set; } = 1;
        public bool IsPaid { get; set; }
        public string Notes { get; set; } = string.Empty;
    }
}
